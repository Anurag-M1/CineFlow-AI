# CineFlow AI Environment Configuration
# All variables are optional for demo mode (deterministic scripted reasoning is enabled by default).

# Database connection URL (SQLite local database)
DATABASE_URL="file:../db/custom.db"

# Google Gemini API Configuration (Optional: activates real LLM reasoning)
# Get an API key from Google AI Studio: https://aistudio.google.com/
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Google Cloud Platform Mapping (Optional: production Agent Builder / Vertex AI integration)
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_LOCATION="us-central1"
